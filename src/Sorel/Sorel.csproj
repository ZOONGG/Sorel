<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\assets\branding\sorel-icon.ico</ApplicationIcon>
    <AssemblyName>Sorel</AssemblyName>
    <RootNamespace>Sorel</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <Version>1.0.0</Version>
    <StartupObject>Sorel.App</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Authors>ZOONGG</Authors>
    <Company>ZOONGG</Company>
    <Copyright>Copyright В© 2026 ZOONGG</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Product>Sorel</Product>
    <Title>Sorel</Title>
    <Description>A modern mod manager and launcher for Lunar Client.</Description>
    <!-- Public endpoint only; no provider credentials are embedded. An explicit
         SorelSupportApiBaseUrl MSBuild property wins over the configuration-specific
         safe default and is stored as assembly metadata for single-file publishes. -->
    <DefaultSorelSupportApiBaseUrl Condition="'$(Configuration)' == 'Release'">https://support-backend-production-8891.up.railway.app</DefaultSorelSupportApiBaseUrl>
    <DefaultSorelSupportApiBaseUrl Condition="'$(Configuration)' != 'Release'">http://127.0.0.1:8787</DefaultSorelSupportApiBaseUrl>
    <SorelSupportApiBaseUrl Condition="'$(SorelSupportApiBaseUrl)' == ''">$(DefaultSorelSupportApiBaseUrl)</SorelSupportApiBaseUrl>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SorelFriendPortable)' == 'true'">
    <DefineConstants>$(DefineConstants);SOREL_FRIEND_PORTABLE</DefineConstants>
    <SorelLocalUpdateFeed></SorelLocalUpdateFeed>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="SorelLocalUpdateFeed" Value="$(SorelLocalUpdateFeed)" Condition="'$(SorelLocalUpdateFeed)' != ''" />
    <AssemblyMetadata Include="SorelSupportApiBaseUrl" Value="$(SorelSupportApiBaseUrl)" />
    <EmbeddedResource Include="..\..\assets\languages\*.sorel-language.json" LogicalName="Sorel.LanguagePacks.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\assets\languages\*.template.json" LogicalName="Sorel.LanguageTemplates.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\assets\languages\README.md" LogicalName="Sorel.LanguageTemplates.README.md" />
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="8.0.31" PrivateAssets="all" />
    <PackageReference Include="NSec.Cryptography" Version="25.4.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <Resource Include="..\..\assets\branding\sorel-icon.ico" Link="Assets\sorel-icon.ico" />
    <Resource Include="..\..\assets\branding\sorel-icon-128.png" Link="Assets\sorel-icon-128.png" />
    <Resource Include="..\..\assets\branding\sorel-tray.ico" Link="Assets\sorel-tray.ico" />
    <Resource Include="Assets\LunarClient.png" />
    <Resource Include="Assets\weave-mod-icon.png" />
    <Resource Include="Assets\Backgrounds\sorel-cosmic-hero.png" />
    <EmbeddedResource Include="..\..\runtime\bridge\Sorel.Native.dll" LogicalName="Sorel.NativeBridge.dll" />
    <EmbeddedResource Include="..\..\runtime\adapters\sorel-bwh-exitlag-network-agent.jar" LogicalName="Sorel.BwhNetworkAgent.jar" />
    <Content Include="..\..\runtime\catalog\Veyra-1.0.1.jar" Link="runtime\catalog\Veyra-1.0.1.jar" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\extensions\MixedWeave\*" Link="licenses\mixed-weave\%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\tools\mixed-weave-adapter\*.java" Link="licenses\mixed-weave\sorel-source\%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\tools\Build-MixedWeaveAdapter.ps1" Link="licenses\mixed-weave\Build-MixedWeaveAdapter.ps1" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\extensions\Sorel.Cosmetics\ASM-LICENSE.txt" Link="licenses\ASM-LICENSE.txt" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\runtime\main-cosmetics-build\sorel-cosmetics-1.3.2.jar" Link="runtime\maintained-builds\sorel-cosmetics-1.3.2.jar" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\runtime\mixed-weave-adapter\sorel-mixed-raven-abi-0.1.0.jar" Link="runtime\mixed-weave-adapter\sorel-mixed-raven-abi-0.1.0.jar" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\runtime\mixed-weave-adapter\sorel-mixed-agent-0.1.0.jar" Link="runtime\mixed-weave-adapter\sorel-mixed-agent-0.1.0.jar" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\runtime\bridge\Sorel.Native.dll" Link="runtime\bridge\Sorel.Native.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Condition="'$(SorelFriendPortable)' != 'true'" />
    <Content Include="..\..\README.md" Link="README.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
